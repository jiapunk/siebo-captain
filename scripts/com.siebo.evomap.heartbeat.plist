<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.siebo.evomap.heartbeat</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/jiachen/Documents/siebo-captain && /Users/jiachen/.local/bin/node node_modules/tsx/dist/cli.mjs scripts/evomap-heartbeat.ts --once >> /tmp/evomap-heartbeat.log 2>&1</string>
