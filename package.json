    "evomap:release": "tsx scripts/evomap-release.ts",
    "evomap:status": "tsx scripts/evomap-status.ts",
    "evomap:heartbeat": "tsx scripts/evomap-heartbeat.ts",
    "evomap:heartbeat:once": "tsx scripts/evomap-heartbeat.ts --once"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.3.5",
    "openai": "^7.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "opencc-js": "^1.4.2",
    "prisma": "^6.19.3",
