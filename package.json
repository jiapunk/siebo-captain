{
  "name": "siebo-captain",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:rebaseline": "tsx scripts/db-rebaseline.ts",
    "db:prune-orphans": "tsx scripts/db-prune-orphans.ts --allow-dev-db",
    "secret-scan": "node scripts/secret-scan.mjs",
    "demo:reset": "tsx prisma/reset-demo.ts --allow-dev-db",
    "demo:snapshot": "tsx scripts/demo-snapshot.ts",
    "demo:restore": "tsx scripts/demo-restore.ts",
    "demo:serve": "next build && next start -H 0.0.0.0 -p ${PORT:-3000}",
    "setup": "node scripts/ensure-env.mjs && npm i && prisma migrate deploy && tsx prisma/seed.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "evomap:register": "tsx scripts/evomap-register.ts",
    "evomap:release": "tsx scripts/evomap-release.ts",
    "evomap:status": "tsx scripts/evomap-status.ts",
    "evomap:heartbeat": "tsx scripts/evomap-heartbeat.ts",
    "evomap:heartbeat:once": "tsx scripts/evomap-heartbeat.ts --once"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.3.5",
    "openai": "^7.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
