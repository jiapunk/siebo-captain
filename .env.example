# ============================================================
# 賽博隊長 環境變數範本
#   npm run setup 在沒有 .env 時會自動複製本檔（scripts/ensure-env.mjs）
#   預設全是安全值：mock 引擎、EvoMap 關閉、金鑰空白 → 不會呼叫任何付費 API
#   Playwright 測試會自行覆寫 DB / mock 設定（見 playwright.config.ts），不會碰你的 dev.db
# ============================================================

# ---- 資料庫（SQLite）----
# 資料庫路徑，相對 prisma/ 目錄（file:./dev.db = prisma/dev.db）
DATABASE_URL="file:./dev.db"

# ---- LLM（隊長對談、文案）----
# mock=內建離線腳本引擎；real=全部走 OpenAI 相容端點；hybrid=LLM 對談＋決策層評分（沒有 LLM_API_KEY 時一律退回 mock）
LLM_PROVIDER=mock
# OpenAI 相容端點（OpenCode Go：https://opencode.ai/zen/go/v1；DeepSeek 官方：https://api.deepseek.com）
LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM 金鑰（留空＝不呼叫 LLM）
LLM_API_KEY=
# 模型名稱（OpenCode Go：deepseek-v4.1-flash；DeepSeek 官方：deepseek-chat）
LLM_MODEL=deepseek-v4.1-flash
# 單次 LLM 請求逾時（毫秒）
LLM_TIMEOUT_MS=45000

# ---- 決策層（Jev / TypeSafe System One：互盤評分）----
# auto=有 JEV_API_KEY 用 Jev、否則有 LLM_API_KEY 用 LLM、都沒有用本機規則；jev=只用 Jev；mock=只用本機規則
DECISION_PROVIDER=auto
# 決策層失敗時的退路：auto=有 LLM key 先退 LLM 再退本機規則；mock=直接退本機規則
DECISION_FALLBACK=auto
# Jev 金鑰（留空＝不呼叫 Jev）
JEV_API_KEY=
# Jev 模型
JEV_MODEL=jev-latest
# Jev 端點
JEV_BASE_URL=https://api.typesafe.ai/v1
# Jev 單次請求逾時（毫秒），逾時自動退回下一層
JEV_TIMEOUT_MS=6000
# 決策層改走 LLM 時的逾時（毫秒）
DECISION_LLM_TIMEOUT_MS=20000
# 只給 scripts/verify-decision.ts 實打 Jev 用的金鑰（一般留空）
JEV_REAL_KEY=

# ---- 活動場次（demo 資料；改完跑 npm run db:seed，格式錯誤會在動資料前中止）----
# 活動名稱
EVENT_NAME="EvoTavern"
# 加入代碼（存成大寫）
EVENT_CODE=EVOTAVERN
# 開始時間（ISO 8601，含時區）
EVENT_STARTS_AT=2026-09-21T09:00:00+08:00
# 結束時間（ISO 8601，含時區；需晚於開始時間）
EVENT_ENDS_AT=2026-09-24T23:59:59+08:00

# ---- 註冊 / 登入 ----
# on=註冊與重寄驗證信時直接在 API 回應附上 email 驗證連結（尚未接 SMTP，demo 需要）；off=不回傳
AUTH_DEV_LINKS=on
# on=忘記密碼時直接在 API 回應附上重設連結（知道 email 就能重設，只給測試用）；off=不回傳
AUTH_DEV_RESET_LINKS=off
# on=允許示範身分切換（只能切到無密碼的示範身分）；off=完全關閉
DEMO_SWITCH=on
# 1=信任 X-Forwarded-For 判斷來源 IP（放在反向代理後面才開）；0=不信任
TRUST_PROXY=0

# ---- GitHub 技能驗證 ----
# mock=不連網、回傳確定性示範結果（測試用）；留空=呼叫 GitHub 公開 API
GITHUB_VERIFY=
# GitHub token（選填；未帶時同一出口 IP 每小時只有 60 次額度）
GITHUB_TOKEN=

# ---- 組隊信號 ----
# social=只用互盤評估分（對照組）；competence=加入 Agent Ledger 能力分（預設）
ASSEMBLY_SIGNAL=competence

# ---- EvoMap GEP-A2A（opt-in）----
# 1=啟用 EvoMap 連線；0=完全不連線
EVOMAP_ENABLED=0
# EvoMap 服務位址
EVOMAP_BASE=https://evomap.ai
# evomap:register 註冊時使用的節點名稱
EVOMAP_NODE_NAME=siebo-captain
# 心跳間隔（毫秒）
EVOMAP_HEARTBEAT_MS=300000
# 心跳自動停止時間（ISO 8601；超過就不再送心跳）
EVOMAP_HEARTBEAT_UNTIL=2026-09-25T00:00:00+08:00
# 可以操作 EvoMap 管理動作的 userId（逗號分隔；留空＝沒有人）
EVOMAP_ADMIN_USER_IDS=
# EVOMAP_NODE_ID 與 EVOMAP_NODE_SECRET 由 npm run evomap:register 自動寫進 .env（請勿手填、勿提交）

# ---- 開發伺服器 ----
# next dev 額外允許的來源 hostname（逗號分隔，不含 http:// 與 port；本機區網 IPv4 會自動加入）
ALLOWED_DEV_ORIGINS=
# 選填：Next build 輸出目錄（預設 .next；測試自動用 .next-test-<port>）
# NEXT_DIST_DIR=.next
# 注意：npm run demo:serve 的 port 讀 shell 環境變數（PORT=3000 npm run demo:serve），寫在 .env 不會生效
