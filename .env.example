# 資料庫（SQLite）
DATABASE_URL="file:./dev.db"

# ---- LLM 設定 ----
# mock   = 內建擬真腳本引擎（離線；Playwright 測試固定使用）
# real   = 全部由 OpenAI 相容端點生成
# hybrid = LLM 負責對談與文案、Jev 決策層負責互盤評分（推薦：快又省）
LLM_PROVIDER=mock

# LLM_PROVIDER=hybrid → LLM 負責對談/文案，互盤評分交給決策層（Jev）

# ---- 決策層（Jev / TypeSafe System One） ----
# auto：有 key 用 Jev、失敗自動退回本機規則；也可強制 mock / jev
DECISION_PROVIDER=auto
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_TIMEOUT_MS=6000

# 範例 A：OpenCode Go 訂閱（可搭配任何 agent；需帶專屬 User-Agent + x-opencode-session）
# LLM_PROVIDER=real
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_API_KEY=sk-你的key
# LLM_MODEL=deepseek-v4.1-flash

# 範例 B：DeepSeek 官方
# LLM_PROVIDER=real
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-你的key
# LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash

# ---- 活動場次（demo 資料） ----
# 改這裡 + npm run db:seed 即可換成你自己的黑客松
EVENT_NAME="EvoTavern"
EVENT_CODE=EVOTAVERN
EVENT_STARTS_AT=2026-09-21T09:00:00+08:00
EVENT_ENDS_AT=2026-09-24T23:59:59+08:00

# ---- 註冊系統 ----
# dev 模式：註冊/重寄驗證/忘記密碼會直接回傳可用連結（方便 demo 與測試）
# 正式上線：設 off，並接上 SMTP 寄信（尚未實作）
AUTH_DEV_LINKS=on

# ---- Jev 決策層（TypeSafe System One：Noul/Choice/Score）----
# auto：有 key 用 Jev，逾時/錯誤/無 key 自動退回本機規則（絕不中斷流程）
DECISION_PROVIDER=auto
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_TIMEOUT_MS=6000

# ---- P2：組隊信號 ----
# social     = 只用互盤評估分（對照組，容易形成小圈圈）
# competence = 加入 Agent Ledger 能力分（預設；跨圈層連結更多）
ASSEMBLY_SIGNAL=competence

# ── EvoMap GEP-A2A（P3，opt-in）──────────────────────────────
# 開啟後才會連線；npm run evomap:register 註冊並寫入節點資訊
EVOMAP_ENABLED=0
# EVOMAP_NODE_ID=node_xxx
# EVOMAP_NODE_SECRET=<64-hex>
